pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ['/busybox/cat']
    tty: true
    volumeMounts:
    - name: registry-credentials
      mountPath: /kaniko/.docker
  - name: kubectl
    image: alpine/k8s:1.29.2
    command: ['sleep']
    args: ['9999999']
  volumes:
  - name: registry-credentials
    secret:
      secretName: scw-registry-credentials
      items:
      - key: .dockerconfigjson
        path: config.json
"""
        }
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['build-and-deploy', 'build-only', 'deploy-only'],
            description: 'Action a effectuer (build-and-deploy = choix par defaut, utilise par le webhook de release)'
        )
        string(
            name: 'IMAGE_TAG_DEPLOY',
            defaultValue: 'latest',
            description: 'Tag image a deployer (utilise uniquement pour deploy-only)'
        )
    }

    environment {
        REGISTRY   = "rg.fr-par.scw.cloud/jenkins-poc-apps"
        IMAGE_NAME = "isaac-fansite"
        IMAGE_TAG  = "${env.RELEASE_TAG ?: env.BUILD_NUMBER}"
    }

    stages {
        stage('Build & Push') {
            when {
                expression { (params.ACTION ?: 'build-and-deploy') in ['build-and-deploy', 'build-only'] }
            }
            steps {
                container('kaniko') {
                    sh """
                        /kaniko/executor \
                          --dockerfile=.deploy/Dockerfile \
                          --context=. \
                          --destination=${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} \
                          --destination=${REGISTRY}/${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('Deploy') {
            when {
                expression { (params.ACTION ?: 'build-and-deploy') in ['build-and-deploy', 'deploy-only'] }
            }
            steps {
                container('kubectl') {
                    script {
                        def tag = params.ACTION == 'deploy-only' ? params.IMAGE_TAG_DEPLOY : env.IMAGE_TAG
                        sh """
                            kubectl set image deployment/isaac-fansite \
                                isaac-fansite=${REGISTRY}/${IMAGE_NAME}:${tag} \
                                -n apps
                            kubectl rollout status deployment/isaac-fansite -n apps
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline termine avec succes - Action: ${params.ACTION}"
        }
        failure {
            echo "Pipeline en echec - Action: ${params.ACTION}"
        }
    }
}